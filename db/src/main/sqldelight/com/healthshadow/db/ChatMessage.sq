CREATE TABLE IF NOT EXISTS chat_message
(
    id           SERIAL8 PRIMARY KEY,
    user_id      BIGINT       REFERENCES users(id) ON DELETE CASCADE,
    role         VARCHAR(20)  NOT NULL CHECK (role IN ('user', 'assistant')),
    content      TEXT         NOT NULL,
    created_at   TIMESTAMP    DEFAULT CURRENT_TIMESTAMP
);

-- Create index for faster user message queries
CREATE INDEX IF NOT EXISTS idx_chat_message_user_id ON chat_message(user_id);
CREATE INDEX IF NOT EXISTS idx_chat_message_created_at ON chat_message(created_at DESC);

-- Get messages by user ID
getMessagesByUserId:
SELECT * FROM chat_message WHERE user_id = ? ORDER BY created_at DESC;

-- Get recent messages by user ID with limit
getRecentMessagesByUserId:
SELECT * FROM chat_message WHERE user_id = ? ORDER BY created_at DESC LIMIT ?;

-- Insert a message
insertMessage:
INSERT INTO chat_message (user_id, role, content)
VALUES (?, ?, ?)
RETURNING id;

-- Get message by ID
getMessageById:
SELECT * FROM chat_message WHERE id = ?;

-- Get all messages ordered by time
getAllMessages:
SELECT * FROM chat_message ORDER BY created_at DESC;

-- Delete messages older than a certain timestamp
deleteOldMessages:
DELETE FROM chat_message WHERE created_at < ?;